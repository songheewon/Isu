{{/if}}
{{/if}}
</div>

      {{!-- {{#if tags}}
      <section class='c-tags'>
        {{ tags separator='' }}
      </section>
      {{/if}} --}}

      {{!-- {{> share }} --}}

      {{#primary_author}}
      {{> card-author }}
      {{/primary_author}}

      {{!-- If the post is published for members and paid members and the visitor is not one of those, show the upgrade
      box --}}
      {{!-- {{#unless @member}}
      {{#if access}}

      {{> subscribe-form-n inputLabel='subscribe-email-post'}}

      {{/if}}
      {{/unless}} --}}
      {{!-- If the post is published for members and paid members and the visitor is not one of those, show the upgrade
      box --}}
      {{else}}
      <!-- from bluedot -->
      {{bluedot_paywall}}
      {{/if}}
    </article>
  </div>
  </div>

  <script>
  (function() {
    try {
      var id = '{{uuid}}';
      if (!id) return;
      var key = 'otter_read_posts';
      var raw = localStorage.getItem(key);
      var list = raw ? JSON.parse(raw) : [];
      if (list.indexOf(id) === -1) {
        list.push(id);
        if (list.length > 500) list = list.slice(-500);
        localStorage.setItem(key, JSON.stringify(list));
      }
    } catch (e) {}
  })();
  </script>

  {{bluedot_paywall_popup}}
  {{/post}}
  {{#if @site.visible_related_post}}
    {{> related-posts}}
  {{/if}}
  {{#if @site.post_visible_shop_section}}
  {{> shop }}
  {{/if}}
  {{!-- {{#get "pages" filter="tag:hash-mobile-ad" include="tags" limit="1" order="published_at desc"}}
  {{#if pages}}
  {{#foreach pages}}
  <div class="c-header-mobile-ad">
    {{#if canonical_url}}
    {{#link href=canonical_url class="c-header-ad__link" target="_blank"}}{{/link}}
    {{/if}}
    {{#if feature_image}}
    <img class="c-header-ad__image" alt="{{#if feature_image_alt}}{{ feature_image_alt }}{{ else }}{{ title }}{{/if}}"
      src="{{img_url feature_image}}" />
    {{/if}}
  </div>
  {{/foreach}}
  {{/if}}
  {{/get}} --}}

