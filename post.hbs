{{!< default}} {{#contentFor 'title' }}{{ meta_title }}{{/contentFor}} {{#post}} <div class='o-grid'>
  <div class='o-grid__col o-grid__col--center o-grid__col--9-10-m o-grid__col--3-4-l'>
    <article class='c-{{ post_class }}'>
      {{> post-header }}

      {{!-- Show the tags, share, author, subscribe box, and comments if visitor can access the post, this means that:
      1. The post is public for anyone
      2. The post is published for subscribers and the visitor is a subscriber
      3. The post is for paid members only and the visitor is a paid member --}}
      {{#if access}}
      <section class='c-content'>
        {{ content }}
      </section>
      {{#if @site.ad_visible_pc_post}}
      <template id="post-ad-template" data-post-ad-position="{{@site.ad_position_post}}">
        {{> banner-ad }}
      </template>
      {{/if}}
      <script>
      (function() {
        var container = document.querySelector('.c-content');
        if (!container) return;
        var tmpl = document.getElementById('post-ad-template');
        if (!tmpl) return;
        var pos = (tmpl.getAttribute('data-post-ad-position') || 'middle').toString().trim().toLowerCase();
        if (pos !== 'top' && pos !== 'middle' && pos !== 'bottom') {
          pos = 'middle';
        }
        var holder = document.createElement('div');
        holder.innerHTML = tmpl.innerHTML.trim();
        if (!holder.firstChild) return;
        var frag = document.createDocumentFragment();
        while (holder.firstChild) {
          frag.appendChild(holder.firstChild);
        }
        if (pos === 'top') {
          if (container.firstChild) {
            container.insertBefore(frag, container.firstChild);
          } else {
            container.appendChild(frag);
          }
          return;
        }
        if (pos === 'bottom') {
          container.appendChild(frag);
          return;
        }
        /* middle: 5번째 단락 다음(6번째 앞). 단락이 부족하면 마지막 p 뒤, p 없으면 본문 끝 */
        var paragraphs = container.querySelectorAll('p');
        if (paragraphs.length >= 6) {
          paragraphs[4].parentNode.insertBefore(frag, paragraphs[5]);
        } else if (paragraphs.length >= 1) {
          paragraphs[paragraphs.length - 1].after(frag);
        } else {
          container.appendChild(frag);
        }
      })();
      </script>
<div class="c-post-subscribe-row">
      <div class="c-post-subscribe-row__comment">
      {{bluedot_comment_button}}
      </div>
      {{#if @member.paid}}
      {{#if @site.use_gift_subscription}}
