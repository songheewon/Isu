{{!< default}} {{#contentFor 'title' }}{{ meta_title }}{{/contentFor}} {{!-- Show the custom homepage content --}}
  {{#get "posts" filter="featured:true" include="tags,authors" limit="1" order="published_at desc"}}
  {{#foreach posts}}
  <section class="c-home-latest">
    <div class="o-container o-container--fluid">
      <div class="c-home-latest__inner{{#unless feature_image}} c-home-latest__inner--text-only{{/unless}}">
        <div class="c-home-latest__content">
          {{#if primary_tag}}
          <p class="c-home-latest__category">
            <a href="{{primary_tag.url}}">{{primary_tag.name}}</a>
          </p>
          {{else if tags}}
          {{#foreach tags limit="1"}}
          <p class="c-home-latest__category">
            <a href="{{url}}">{{name}}</a>
          </p>
          {{/foreach}}
          {{/if}}
          <h2 class="c-home-latest__title">
            <a href="{{url}}">{{title}}</a>
          </h2>
          {{#if excerpt}}
          <p class="c-home-latest__excerpt">{{excerpt words="44"}}</p>
          {{/if}}
          <a href="{{url}}" class="c-home-latest__btn">자세히 보기</a>
        </div>
        {{#if feature_image}}
        <div class="c-home-latest__media">
          <a href="{{url}}" class="c-home-latest__media-link">
            <img
              class="c-home-latest__image lazyload"
              src="{{img_url feature_image}}"
              alt="{{title}}"
            />
          </a>
        </div>
        {{/if}}
      </div>
    </div>
  </section>
  {{/foreach}}
  {{/get}}

  {{> home/recommended homePagination=pagination}}
  {{!-- Ajax: 다음 홈 페이지 HTML에서 추출 — 추천 카드와 동일 마크업 --}}
  <div class="js-home-recommended-fetch-source" hidden aria-hidden="true">
    {{#foreach posts}}
      {{> home/recommended-card}}
    {{/foreach}}
  </div>

  {{> home/rankings-split}}

{{#if @site.ad_visible_pc_home}}
  {{#match @site.ad_position_home "=" "middle"}}
    {{> ad }}
  {{/match}}
  {{/if}}
  
      {{!-- 구독 영역 --}}
  {{> subscribe-form-n}}

  {{!-- {{> home/featured-second}} --}}

  {{#if @site.tag_names}}
  {{> home/tag-category-sections tag_slugs=@site.tag_names}}
  {{else if @custom.tag_names}}
  {{> home/tag-category-sections tag_slugs=@custom.tag_names}}
  {{/if}}

  

  {{> home/editors-intro}}

  {{#if @site.home_visible_shop_section}}
  {{> shop }}
  {{/if}}



