<section class="c-subscribe-banner" aria-label="{{t 'Subscribe'}}">
  <div class="o-container o-container--fluid o-container--fluid-balanced">
    <div
      class="c-subscribe-banner__box"
      style="--subscribe-banner-bg: url({{asset "images/subscribe-banner-bg.svg"}});"
    >
      <div class="c-subscribe-banner__text">
        <p class="c-subscribe-banner__eyebrow">뉴스레터 구독</p>
        <h2 class="c-subscribe-banner__title">
          {{#if @site.subscription_form_title}}
            {{@site.subscription_form_title}}
          {{else}}
            뉴스레터를 구독하고 소식을 받아보세요!
          {{/if}}
        </h2>
      </div>
      <form
        data-members-form="subscribe"
        class="c-subscribe-banner__form c-subscribe-form"
      >
        <div class="c-subscribe-banner__fields">
          <label for="{{#if inputLabel}}{{inputLabel}}{{else}}subscribe-email-banner{{/if}}" class="u-hidden-visually">{{t "Your email address"}}</label>
          <input
            type="email"
            name="email"
            id="{{#if inputLabel}}{{inputLabel}}{{else}}subscribe-email-banner{{/if}}"
            class="c-subscribe-banner__input"
            placeholder="이메일을 입력해주세요."
            required
            data-members-email
          />
          <button type="submit" class="c-subscribe-banner__submit">뉴스레터 구독하기</button>
        </div>
        <div class="c-alert c-alert--success">이메일이 발송되었습니다. 링크를 클릭하여 구독을 확인해주세요.</div>
        <div class="c-alert c-alert--invalid">유효한 이메일을 입력해주세요.</div>
        <div class="c-alert c-alert--error">오류가 발생했습니다. 나중에 다시 시도해주세요.</div>
      </form>
    </div>
  </div>
</section>
