{{#if @site.home_visible_shop_section}}
  <div class="c-shop">
    <div class="o-container o-container--fluid o-container--fluid-balanced">
      <div class="c-shop__inner">
        <div class="header">
          <div class="c-shop__title">{{#if @site.shop_section_title}}{{@site.shop_section_title}}{{else}}Shop{{/if}}</div>
          <div class="c-shop__tags">
            {{> shop/tags type="all" }}
          </div>
        </div>
        {{> shop/carousel }}
      </div>
    </div>
  </div>
  <div class="c-shop-more-wrap o-container o-container--fluid o-container--fluid-balanced">
    <a class="c-shop-more" href="/shop/">Shop 상품 더보기</a>
  </div>
  {{/if}}
