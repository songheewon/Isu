<article class="c-home-recommended-card">
  <a href="{{url}}" class="c-home-recommended-card__thumb">
    {{#if feature_image}}
    <img
      class="c-home-recommended-card__img lazyload"
      src="{{img_url feature_image}}"
      alt="{{title}}"
    />
    {{else}}
    <div class="c-home-recommended-card__thumb--empty" aria-hidden="true"></div>
    {{/if}}
  </a>
  <h3 class="c-home-recommended-card__title">
    <a href="{{url}}">{{title}}</a>
  </h3>
  <div class="c-home-recommended-card__meta">
    {{#primary_author}}
    <a href="{{url}}" class="c-home-recommended-card__author">
      {{#if profile_image}}
      <img
        class="c-home-recommended-card__avatar lazyload"
        src="{{img_url profile_image}}"
        alt=""
      />
      {{else}}
      <span class="c-home-recommended-card__avatar c-home-recommended-card__avatar--empty" aria-hidden="true">
        {{> icons/user-profile}}
      </span>
      {{/if}}
      <span class="c-home-recommended-card__author-name">{{name}}</span>
    </a>
    {{/primary_author}}
  </div>
</article>
