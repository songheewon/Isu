<section class="c-home-rankings" aria-label="인기 콘텐츠와 최근 올라온 콘텐츠">
  <div class="o-container o-container--fluid o-container--fluid-balanced">
    <div class="c-home-rankings__grid">
      <aside class="c-home-rankings__col c-home-rankings__col--popular">
        <div class="c-home-rankings__heading">인기 콘텐츠</div>
        {{#match @site.feature_content_section_due_date "=" "seven_days"}}
        {{#get "posts" filter="published_at:>=now-7d" limit="5" order="view_count desc" include="tags,authors"}}
        {{#if posts}}
        <ol class="c-home-rankings__list">
          {{#foreach posts}}
          <li class="c-home-rankings__item">
            <a href="{{url}}" class="c-home-rankings__link">{{title}}</a>
          </li>
          {{/foreach}}
        </ol>
        {{/if}}
        {{/get}}
        {{else match @site.feature_content_section_due_date "=" "fourteen_days"}}
        {{#get "posts" filter="published_at:>=now-14d" limit="5" order="view_count desc" include="tags,authors"}}
        {{#if posts}}
        <ol class="c-home-rankings__list">
          {{#foreach posts}}
          <li class="c-home-rankings__item">
            <a href="{{url}}" class="c-home-rankings__link">{{title}}</a>
          </li>
          {{/foreach}}
        </ol>
        {{/if}}
        {{/get}}
        {{else}}
        {{#get "posts" filter="published_at:>=now-30d" limit="5" order="view_count desc" include="tags,authors"}}
        {{#if posts}}
        <ol class="c-home-rankings__list">
          {{#foreach posts}}
          <li class="c-home-rankings__item">
            <a href="{{url}}" class="c-home-rankings__link">{{title}}</a>
          </li>
          {{/foreach}}
        </ol>
        {{/if}}
        {{/get}}
        {{/match}}

        <div class="c-home-rankings__tags">
          <h3 class="c-home-rankings__tags-title">인기 태그</h3>
          {{#get "tags" limit="18" order="count.posts desc"}}
          {{#if tags}}
          <div class="c-home-rankings__tags-inner">
            {{#foreach tags}}
            <a href="{{url}}" class="c-home-rankings__tag">{{name}}</a>
            {{/foreach}}
          </div>
          {{/if}}
          {{/get}}
        </div>
      </aside>

      <div class="c-home-rankings__col c-home-rankings__col--recent">
        <div class="c-home-rankings__heading">최근 올라온 콘텐츠</div>
        {{#get "posts" limit="all" order="published_at desc" include="tags,authors"}}
        {{#if posts}}
        <div class="c-home-rankings__cards js-home-rankings-cards" data-batch-size="3">
          {{#foreach posts to="3"}}
          {{> home/rankings-card}}
          {{/foreach}}
        </div>
        <div class="c-home-rankings__queue js-home-rankings-queue" hidden aria-hidden="true">
          {{#foreach posts from="4"}}
          {{> home/rankings-card}}
          {{/foreach}}
        </div>
        {{#if posts.[3]}}
        <div class="c-home-rankings__more">
          <button type="button" class="c-btn c-pagination__btn js-rankings-more">더보기</button>
        </div>
        {{/if}}
        {{/if}}
        {{/get}}
      </div>
    </div>
  </div>
</section>
