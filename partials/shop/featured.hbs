{{#get "products" limit=20 filter="featured:true"}}
{{#if products}}
<div class="c-shop-featured">
  <div class="o-grid">
    <div class="c-shop-featured__carousel">
      <div class="c-shop-featured__carousel--swiper">

        <!-- Additional required wrapper -->
        <div class="swiper-wrapper">
          {{#foreach products}}
          <div class="swiper-slide">
            {{> product-featured }}
          </div>
          {{/foreach}}
          <!-- Slides -->
        </div>
      </div>

      <!-- If we need pagination -->
      <div class="swiper-pagination"></div>

      <!-- If we need navigation buttons -->
      <div class="swiper-button-prev">
        {{> icons/swiper-nav-arrow}}
      </div>
      <div class="swiper-button-next">
        {{> icons/swiper-nav-arrow}}
      </div>

    </div>
  </div>
</div>
{{/if}}
{{/get}}