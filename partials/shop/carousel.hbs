{{#get "products" order="published_at desc"}}
{{#if products}}
<div class="c-shop-carousel shop-carousel relative">
  <div class="c-shop-carousel__swiper shop-swiper overflow-hidden">
    <!-- Additional required wrapper -->
    <div class="swiper-wrapper">
    {{#foreach products}}
      <div class="swiper-slide">
      {{> product-card }}
      </div>
    {{/foreach}}
    </div>
  </div>

  <!-- If we need pagination -->
  <div class="swiper-pagination"></div>

  <!-- If we need navigation buttons -->
  <div class="swiper-button-prev">
    {{> icons/swiper-nav-arrow}}
  </div>
  <div class="swiper-button-next">
    {{> icons/swiper-nav-arrow}}
  </div>
</div>

<script>
(function initShopSwiper() {
  var shopSwiperEl = document.querySelector('.shop-swiper');
  if (!shopSwiperEl) return;
  if (shopSwiperEl.swiper) return;
  
  if (typeof Swiper === 'undefined') {
    setTimeout(initShopSwiper, 100);
    return;
  }
  
  var paginationEl = document.querySelector('.shop-carousel .swiper-pagination');
  var nextEl = document.querySelector('.shop-carousel .swiper-button-next');
  var prevEl = document.querySelector('.shop-carousel .swiper-button-prev');
  
  var swiperConfig = {
    spaceBetween: 20,
    // 기본 navigation 설정
    navigation: nextEl && prevEl ? {
      nextEl: nextEl,
      prevEl: prevEl,
    } : undefined,
    // 기본 pagination 설정
    pagination: paginationEl ? {
      el: paginationEl,
      clickable: true,
    } : undefined,
    breakpoints: {
      320: {
        slidesPerView: 2, // 모바일: 2개씩 보이게
        spaceBetween: 12, // 패딩 축소
        navigation: false, // 모바일에서 화살표 비활성화
        pagination: {
          enabled: true,
          clickable: true,
        }
      },
      480: {
        slidesPerView: 2,
        spaceBetween: 16, // 패딩 축소
        navigation: false,
        pagination: {
          enabled: true,
          clickable: true,
        }
      },
      640: {
        slidesPerView: 2,
        spaceBetween: 20, // 패딩 축소
        navigation: false,
        pagination: {
          enabled: true,
          clickable: true,
        }
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 26,
        navigation: false,
        pagination: {
          enabled: false
        }
      },
      1240: {
        slidesPerView: 4,
        spaceBetween: 26,
        navigation: nextEl && prevEl ? {
          nextEl: nextEl,
          prevEl: prevEl,
        } : false,
        pagination: {
          enabled: false
        }
      },
    }
  };
  
  try {
    new Swiper('.shop-swiper', swiperConfig);
  } catch (e) {
    console.error('Shop Swiper error:', e);
  }
})();
</script>
{{/if}}
{{/get}}

