{{!-- layout: image-only | image-title | image-title-desc (Chunpo 스타일 풀폭 히어로) --}}
{{#if feature_image}}
<div class="c-post-image-header-template">
  <div class="c-post-image-header-template__wrap">
    <img
      alt="{{#if feature_image_alt}}{{ feature_image_alt }}{{else}}{{ title }}{{/if}}"
      class="c-post-image-header-template__img lazyload"
      data-srcset="{{img_url feature_image size='s'}} 320w, {{img_url feature_image size='m'}} 600w, {{img_url feature_image size='l'}} 1200w, {{img_url feature_image size='xl'}} 2000w"
      data-src="{{img_url feature_image size='xl'}}"
    />
  </div>
  {{#match layout "image-title"}}
  <div class="c-post-image-header-template__title_and_excerpt c-post-header__title">
    <div class="c-post-image-header-template__title">{{title}}</div>
  </div>
  {{/match}}
  {{#match layout "image-title-desc"}}
  <div class="c-post-image-header-template__title_and_excerpt c-post-header__title">
    <div class="c-post-image-header-template__title">{{title}}</div>
    <div class="c-post-image-header-template__excerpt">{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{excerpt}}{{/if}}</div>
  </div>
  {{/match}}
</div>
{{/if}}
