<section class='c-card-author'>
  {{#if profile_image}}
    <div class='c-card-author__media'>
      <a href='{{ url }}'>
        <img class='c-card-author__image lazyload' data-src='{{ img_url profile_image }}' alt='{{ name }}' width='80' height='80'>
      </a>
    </div>
  {{else}}
    <div class='c-card-author__media c-card-author__media--placeholder'>
      <a href='{{ url }}' aria-label='{{ name }}'>
        {{> icons/user-profile}}
      </a>
    </div>
  {{/if}}

  <div class='c-card-author__content'>
    <h3 class='c-card-author__name'>
      <a href='{{ url }}'>{{ name }}</a>
    </h3>

    {{#if bio}}
      <div class="c-card-author__bio bluedot-markdown">{{markdown bio}}</div>
    {{/if}}

    <ul class="c-card-author__sns o-plain-list">
      {{#if facebook}}
      <li class="c-card-author__sns-item">
        <a href="{{facebook_url}}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 0C4.477 0 0 4.477 0 10c0 4.991 3.657 9.128 8.438 9.879V12.89H5.898V10h2.54V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V10h2.773l-.443 2.89h-2.33v6.989C16.343 19.129 20 14.99 20 10c0-5.523-4.477-10-10-10z" fill="currentColor"/></svg>
        </a>
      </li>
      {{/if}}
      {{#if instagram}}
      <li class="c-card-author__sns-item">
        <a href="https://www.instagram.com/{{instagram}}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 1.802c2.67 0 2.986.01 4.04.058 2.71.124 3.976 1.41 4.1 4.1.048 1.054.058 1.37.058 4.04s-.01 2.986-.058 4.04c-.124 2.688-1.387 3.976-4.1 4.1-1.054.048-1.37.058-4.04.058s-2.986-.01-4.04-.058c-2.717-.124-3.976-1.415-4.1-4.1C1.812 12.986 1.802 12.67 1.802 10s.01-2.986.058-4.04c.124-2.69 1.387-3.976 4.1-4.1C7.014 1.812 7.33 1.802 10 1.802zM10 0C7.284 0 6.944.012 5.878.06 2.246.227.227 2.242.06 5.877.012 6.944 0 7.284 0 10s.012 3.057.06 4.123c.167 3.632 2.182 5.65 5.817 5.817C6.944 19.988 7.284 20 10 20s3.057-.012 4.123-.06c3.629-.167 5.652-2.182 5.817-5.817.048-1.066.06-1.407.06-4.123s-.012-3.056-.06-4.122C19.777 2.249 17.76.228 14.124.06 13.057.012 12.716 0 10 0zm0 4.865a5.135 5.135 0 100 10.27 5.135 5.135 0 000-10.27zm0 8.468a3.333 3.333 0 110-6.666 3.333 3.333 0 010 6.666zm5.338-9.87a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z" fill="currentColor"/></svg>
        </a>
      </li>
      {{/if}}
      {{#if twitter}}
      <li class="c-card-author__sns-item">
        <a href="{{twitter_url}}" target="_blank" rel="noopener" aria-label="X">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15.27 1.5h2.83l-6.18 7.07L19 18.5h-5.7l-4.46-5.83L3.74 18.5H.91l6.61-7.55L.67 1.5h5.84l4.03 5.33L15.27 1.5zm-.99 15.27h1.57L5.78 3.07H4.1l10.18 13.7z" fill="currentColor"/></svg>
        </a>
      </li>
      {{/if}}
      {{#if youtube}}
      <li class="c-card-author__sns-item">
        <a href="https://www.youtube.com/{{youtube}}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M19.593 5.2a2.51 2.51 0 00-1.768-1.778C16.254 3 10 3 10 3s-6.254 0-7.825.422A2.51 2.51 0 00.407 5.2C0 6.78 0 10.092 0 10.092s0 3.312.407 4.892a2.51 2.51 0 001.768 1.778C3.746 17.184 10 17.184 10 17.184s6.254 0 7.825-.422a2.51 2.51 0 001.768-1.778c.407-1.58.407-4.892.407-4.892s0-3.312-.407-4.892zM7.955 13.092V7.092l5.227 3-5.227 3z" fill="currentColor"/></svg>
        </a>
      </li>
      {{/if}}
    </ul>
  </div>
</section>